# Copia este archivo a .env y completa los valores. Nunca subas .env al repo.
# Esta app no usa API keys de terceros en el MVP.

# Contraseña de PostgreSQL para producción (config/database.yml la lee en production).
ASTRONAUT_HEALTH_DATABASE_PASSWORD=

# Solo si despliegas fuera de Docker: pega aquí el contenido de config/master.key.
RAILS_MASTER_KEY=
