<%# Badge de enlace con Tierra. Se coloca en la cabecera, junto al botón
    "+ Registrar nueva medición". offline_controller actualiza sus clases y
    su texto según los eventos online/offline del navegador. %>
<span data-offline-target="badge"
      class="inline-flex items-center gap-2 rounded-full border border-emerald-500/40 bg-emerald-500/10 px-3 py-1.5 text-sm font-medium text-emerald-300 transition-colors duration-300">
  <span data-offline-target="dot" class="inline-block h-2 w-2 rounded-full bg-emerald-400"></span>
  <span data-offline-target="label">📡 Earth link: ACTIVE</span>
</span>

<%# Contador de mediciones pendientes de sincronizar. Solo aparece si hay cola. %>
<span data-offline-target="pending"
      class="hidden items-center gap-1.5 rounded-full border border-amber-500/40 bg-amber-500/10 px-2.5 py-1 text-[11px] font-semibold text-amber-200">
  0 queued
</span>
