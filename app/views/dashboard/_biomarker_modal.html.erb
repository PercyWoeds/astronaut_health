<%# Tarjeta de muestras biológicas (Immune Biomarkers / Standard Measures). %>
<div data-controller="modal" class="contents">
  <button type="button" data-action="click->modal#open" class="<%= quick_action_button_classes %>">
    🧪 Muestras Biológicas
  </button>

  <div data-modal-target="modal" data-action="click->modal#closeOnBackdrop"
       class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 p-4 backdrop-blur-sm">
    <div class="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-2xl border border-slate-700 bg-slate-900 p-6 shadow-2xl">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-300">Immune Biomarkers</p>
          <h2 class="mt-1 text-xl font-semibold text-white">Registrar muestra biológica</h2>
          <p class="mt-1 text-sm text-slate-400">Saliva seca, sangre u orina para los estudios de inmunidad.</p>
        </div>
        <button type="button" data-action="click->modal#close"
                class="rounded-lg border border-slate-700 px-2.5 py-1 text-sm text-slate-400 hover:bg-slate-800">✕</button>
      </div>

      <%= form_with url: biomarker_samples_path(mission_id: @astronaut.mission_id, astronaut_id: @astronaut.id),
                    scope: :biomarker_sample, method: :post, class: "mt-5 space-y-4" do |form| %>
        <div>
          <%= form.label :sample_type, "Tipo de muestra", class: "mb-1 block text-sm font-medium text-slate-300" %>
          <%= form.select :sample_type,
                BiomarkerSample::SAMPLE_TYPES.map { |key, label| [ label, key ] },
                {},
                class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-slate-100 outline-none focus:border-teal-500" %>
        </div>

        <div>
          <%= form.label :collected_at, "Fecha y hora de recolección", class: "mb-1 block text-sm font-medium text-slate-300" %>
          <%= form.datetime_local_field :collected_at, value: Time.current.strftime("%Y-%m-%dT%H:%M"),
                class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-slate-100 outline-none focus:border-teal-500" %>
        </div>

        <div>
          <%= form.label :notes, "Notas (opcional)", class: "mb-1 block text-sm font-medium text-slate-300" %>
          <%= form.text_area :notes, rows: 3, maxlength: 2_000, placeholder: "Condiciones de la muestra, incidencias…",
                class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-slate-100 outline-none focus:border-teal-500" %>
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button type="button" data-action="click->modal#close"
                  class="rounded-xl border border-slate-700 px-4 py-2 text-sm text-slate-300 hover:bg-slate-800">Cancelar</button>
          <button type="submit"
                  class="rounded-xl bg-teal-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-teal-400">
            Guardar muestra
          </button>
        </div>
      <% end %>

      <% if @biomarker_samples.any? %>
        <div class="mt-5 border-t border-slate-800 pt-4">
          <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Muestras recientes</p>
          <ul class="mt-2 space-y-2">
            <% @biomarker_samples.each do |sample| %>
              <li class="flex items-start justify-between gap-3 rounded-xl border border-slate-800 bg-slate-950/60 p-3">
                <div class="min-w-0">
                  <p class="text-sm font-medium text-slate-200"><%= sample.type_label %></p>
                  <% if sample.notes.present? %>
                    <p class="mt-0.5 truncate text-[11px] text-slate-400"><%= sample.notes %></p>
                  <% end %>
                </div>
                <span class="shrink-0 text-[10px] text-slate-500"><%= relative_time_es(sample.collected_at) %></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </div>
</div>