<%# Evaluación diaria de los estudios NASA: Immune, CIPHER, SANS y ARCHeR. %>
<div data-controller="modal" class="contents">
  <button type="button" data-action="click->modal#open" class="<%= quick_action_button_classes %>">
    🛰️ NASA Studies
  </button>

  <div data-modal-target="modal" data-action="click->modal#closeOnBackdrop"
       class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 p-4 backdrop-blur-sm">
    <div class="max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-2xl border border-slate-700 bg-slate-900 p-6 shadow-2xl">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-indigo-300">NASA HRP · Artemis II</p>
          <h2 class="mt-1 text-xl font-semibold text-white">Research studies</h2>
          <p class="mt-1 text-sm text-slate-400">Immune Biomarkers, CIPHER, SANS/B-Complex and ARCHeR.</p>
        </div>
        <button type="button" data-action="click->modal#close"
                class="rounded-lg border border-slate-700 px-2.5 py-1 text-sm text-slate-400 hover:bg-slate-800">✕</button>
      </div>

      <%= form_with url: research_assessments_path(mission_id: @astronaut.mission_id, astronaut_id: @astronaut.id),
                    scope: :research_assessment, method: :post, class: "mt-5 space-y-5" do |form| %>

        <div>
          <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Immune Biomarkers · Standard Measures</p>
          <div class="mt-2 grid gap-3 sm:grid-cols-2">
            <% [
              { field: :saliva_sample_taken, label: "Dry saliva taken", hint: "Artemis method", value: @research_assessment.saliva_sample_taken },
              { field: :virus_reactivation_suspected, label: "Viral reactivation", hint: "E.g. latent shingles", value: @research_assessment.virus_reactivation_suspected }
            ].each do |toggle| %>
              <label class="flex cursor-pointer items-center justify-between gap-3 rounded-xl border border-slate-800 bg-slate-950/60 p-3">
                <span>
                  <span class="block text-sm font-medium text-slate-200"><%= toggle[:label] %></span>
                  <span class="block text-[11px] text-slate-500"><%= toggle[:hint] %></span>
                </span>
                <span class="relative inline-flex shrink-0 items-center">
                  <%= form.check_box toggle[:field], checked: toggle[:value], class: "peer sr-only" %>
                  <span class="h-6 w-11 rounded-full bg-slate-700 transition peer-checked:bg-cyan-500"></span>
                  <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white transition peer-checked:translate-x-5"></span>
                </span>
              </label>
            <% end %>
          </div>
        </div>

        <div class="border-t border-slate-800 pt-4">
          <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">SANS · B-Complex</p>
          <div class="mt-2 grid gap-3 sm:grid-cols-2">
            <% [
              { field: :vision_test_performed, label: "Vision test performed", hint: "Required every 7 days", value: @research_assessment.vision_test_performed },
              { field: :b_complex_supplement_taken, label: "B-Complex study", hint: "Only if enrolled: supplement taken today", value: @research_assessment.b_complex_supplement_taken }
            ].each do |toggle| %>
              <label class="flex cursor-pointer items-center justify-between gap-3 rounded-xl border border-slate-800 bg-slate-950/60 p-3">
                <span>
                  <span class="block text-sm font-medium text-slate-200"><%= toggle[:label] %></span>
                  <span class="block text-[11px] text-slate-500"><%= toggle[:hint] %></span>
                </span>
                <span class="relative inline-flex shrink-0 items-center">
                  <%= form.check_box toggle[:field], checked: toggle[:value], class: "peer sr-only" %>
                  <span class="h-6 w-11 rounded-full bg-slate-700 transition peer-checked:bg-cyan-500"></span>
                  <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white transition peer-checked:translate-x-5"></span>
                </span>
              </label>
            <% end %>
          </div>

          <div class="mt-3">
            <%= form.label :oct_scan_result, "OCT result", class: "mb-1 block text-sm font-medium text-slate-300" %>
            <%= form.select :oct_scan_result,
                  ResearchAssessment::OCT_RESULTS.map { |result| [ { "normal" => "Normal", "borderline" => "Borderline", "abnormal" => "Abnormal" }.fetch(result), result ] },
                  { selected: @research_assessment.oct_scan_result },
                  class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-slate-100 outline-none focus:border-indigo-500" %>
          </div>
        </div>

        <div class="border-t border-slate-800 pt-4">
          <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">CIPHER · Bone Health · Telomeres · Spatial Cognition</p>
          <div class="mt-2 grid gap-4 sm:grid-cols-2">
            <div>
              <%= form.label :calcium_isotopes_level, "Calcium (mg/dL)", class: "mb-1 block text-sm font-medium text-slate-300" %>
              <%= form.number_field :calcium_isotopes_level, step: "0.1", value: @research_assessment.calcium_isotopes_level,
                    class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-slate-100 outline-none focus:border-indigo-500" %>
            </div>
            <div>
              <%= form.label :telomere_length, "Telomeres (kb)", class: "mb-1 block text-sm font-medium text-slate-300" %>
              <%= form.number_field :telomere_length, step: "0.1", value: @research_assessment.telomere_length,
                    class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-slate-100 outline-none focus:border-indigo-500" %>
            </div>
            <div>
              <%= form.label :spatial_cognition_score, "Spatial cognition (1-100)", class: "mb-1 block text-sm font-medium text-slate-300" %>
              <%= form.number_field :spatial_cognition_score, min: 1, max: 100, step: 1, value: @research_assessment.spatial_cognition_score,
                    class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-slate-100 outline-none focus:border-indigo-500" %>
            </div>
          </div>
        </div>

        <div class="border-t border-slate-800 pt-4">
          <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">ARCHeR · Actigraphy and performance</p>
          <div class="mt-2 grid gap-4 sm:grid-cols-2">
            <label class="flex cursor-pointer items-center justify-between gap-3 rounded-xl border border-slate-800 bg-slate-950/60 p-3">
              <span>
                <span class="block text-sm font-medium text-slate-200">Actigraphy synced</span>
                <span class="block text-[11px] text-slate-500">Sleep and activity</span>
              </span>
              <span class="relative inline-flex shrink-0 items-center">
                <%= form.check_box :actigraphy_device_synced, checked: @research_assessment.actigraphy_device_synced, class: "peer sr-only" %>
                <span class="h-6 w-11 rounded-full bg-slate-700 transition peer-checked:bg-cyan-500"></span>
                <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white transition peer-checked:translate-x-5"></span>
              </span>
            </label>
            <div>
              <%= form.label :cognitive_performance_survey_score, "Cognitive survey (0-100)", class: "mb-1 block text-sm font-medium text-slate-300" %>
              <%= form.number_field :cognitive_performance_survey_score, min: 0, max: 100, step: 1, value: @research_assessment.cognitive_performance_survey_score,
                    class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-slate-100 outline-none focus:border-indigo-500" %>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button type="button" data-action="click->modal#close"
                  class="rounded-xl border border-slate-700 px-4 py-2 text-sm text-slate-300 hover:bg-slate-800">Cancel</button>
          <button type="submit"
                  class="rounded-xl bg-indigo-500 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-400">
            Save studies
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>