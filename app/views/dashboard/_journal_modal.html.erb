<%# Diario de a bordo: contramedida del riesgo psicosocial de aislamiento. %>
<div data-controller="modal" class="contents">
  <button type="button" data-action="click->modal#open" class="<%= quick_action_button_classes %>">
    📝 Diario a Bordo
  </button>

  <div data-modal-target="modal" data-action="click->modal#closeOnBackdrop"
       class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 p-4 backdrop-blur-sm">
    <div class="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-2xl border border-slate-700 bg-slate-900 p-6 shadow-2xl">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-violet-300">Riesgo psicosocial</p>
          <h2 class="mt-1 text-xl font-semibold text-white">Diario de a bordo</h2>
          <p class="mt-1 text-sm text-slate-400">Escribe cómo te sientes. El registro ayuda a mitigar el aislamiento.</p>
        </div>
        <button type="button" data-action="click->modal#close"
                class="rounded-lg border border-slate-700 px-2.5 py-1 text-sm text-slate-400 hover:bg-slate-800">✕</button>
      </div>

      <%= form_with url: journal_entries_path(mission_id: @astronaut.mission_id, astronaut_id: @astronaut.id),
                    scope: :journal_entry, method: :post, class: "mt-5 space-y-4" do |form| %>
        <%= form.text_area :content, rows: 5, maxlength: 5_000, required: true,
              placeholder: "Hoy me he sentido…",
              class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-slate-100 outline-none focus:border-violet-500" %>
        <div class="flex items-center justify-end gap-3">
          <button type="button" data-action="click->modal#close"
                  class="rounded-xl border border-slate-700 px-4 py-2 text-sm text-slate-300 hover:bg-slate-800">Cancelar</button>
          <button type="submit"
                  class="rounded-xl bg-violet-500 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-400">
            Guardar entrada
          </button>
        </div>
      <% end %>

      <% if @journal_entries.any? %>
        <div class="mt-5 border-t border-slate-800 pt-4">
          <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Entradas recientes</p>
          <ul class="mt-2 space-y-2">
            <% @journal_entries.each do |entry| %>
              <li class="rounded-xl border border-slate-800 bg-slate-950/60 p-3">
                <p class="text-xs leading-relaxed text-slate-300"><%= truncate(entry.content, length: 180) %></p>
                <p class="mt-1 text-[10px] text-slate-500"><%= relative_time_es(entry.created_at) %></p>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </div>
</div>