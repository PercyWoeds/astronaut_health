<%# Test de reacción de 1 minuto (CIPHER / Spatial Cognition). %>
<div data-controller="modal" class="contents">
  <button type="button" data-action="click->modal#open" class="<%= quick_action_button_classes %>">
    🧠 Reaction Test
  </button>

  <div data-modal-target="modal" data-action="click->modal#closeOnBackdrop"
       class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 p-4 backdrop-blur-sm">
    <div class="w-full max-w-md rounded-2xl border border-slate-700 bg-slate-900 p-6 shadow-2xl"
         data-controller="reaction-test"
         data-reaction-test-url-value="<%= health_readings_path(mission_id: @astronaut.mission_id, astronaut_id: @astronaut.id) %>">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-cyan-400">CIPHER · Spatial Cognition</p>
          <h2 class="mt-1 text-xl font-semibold text-white">Reaction test</h2>
        </div>
        <button type="button" data-action="click->modal#close"
                class="rounded-lg border border-slate-700 px-2.5 py-1 text-sm text-slate-400 hover:bg-slate-800">✕</button>
      </div>

      <p data-reaction-test-target="prompt" class="mt-4 text-center text-sm font-medium text-slate-300">
        Click when green appears.
      </p>

      <button type="button" data-reaction-test-target="button" data-action="click->reaction-test#press"
              class="mt-4 flex h-40 w-full items-center justify-center rounded-2xl border-2 border-slate-600 bg-slate-800 font-mono text-lg font-bold text-slate-100 transition hover:bg-slate-700">
        Start test
      </button>

      <p data-reaction-test-target="result" class="mt-3 text-center font-mono text-sm text-cyan-200"></p>
      <p data-reaction-test-target="warning"
         class="mt-2 hidden rounded-xl border border-amber-500/30 bg-amber-500/10 px-3 py-2 text-center text-xs text-amber-200">
         Cognitive fatigue detected. Rest recommended (CIPHER / Spatial Cognition).
      </p>
      <p data-reaction-test-target="error"
         class="mt-2 hidden rounded-xl border border-rose-500/30 bg-rose-500/10 px-3 py-2 text-center text-xs text-rose-200"></p>

      <p class="mt-4 text-center text-[11px] leading-relaxed text-slate-500">
        The button turns green after 2–5 s. If you click earlier, the attempt is voided.
        The result is saved as a health reading.
      </p>
    </div>
  </div>
</div>