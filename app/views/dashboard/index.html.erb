<% status_pill = {
  "green" => "bg-emerald-500/15 text-emerald-300 border-emerald-500/40",
  "yellow" => "bg-amber-500/15 text-amber-300 border-amber-500/40",
  "red" => "bg-rose-500/15 text-rose-300 border-rose-500/40"
} %>
<% status_dot = { "green" => "bg-emerald-400", "yellow" => "bg-amber-400", "red" => "bg-rose-400" } %>
<% overall = @snapshot&.dig(:overall_status) || "green" %>
<% zone_labels = { "head" => "Cabeza", "chest" => "Tórax", "abdomen" => "Abdomen", "limbs" => "Extremidades" } %>
<% alert_zones = Array(@snapshot&.dig(:zones)).select { |zone| zone[:status] == overall } %>
<% alert_zone_names = alert_zones.map { |zone| zone_labels[zone[:name]] || zone[:name] }.join(", ") %>

<% content_for :head do %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<% end %>

<div class="mx-auto max-w-7xl rounded-3xl px-4 py-6 transition-shadow duration-500 lg:px-8"
     data-body-3d-target="alert"
     data-controller="body-3d health-form health-charts mission-selector offline sos hrp-risks"
     data-body-3d-url-value="<%= api_health_status_path(mission_id: @current_mission&.id, astronaut_id: @astronaut&.id) %>"
     data-health-form-url-value="<%= health_readings_path(mission_id: @current_mission&.id, astronaut_id: @astronaut&.id) %>"
     data-offline-url-value="<%= health_readings_path(mission_id: @current_mission&.id, astronaut_id: @astronaut&.id) %>"
     data-hrp-risks-url-value="<%= api_hrp_risks_path(mission_id: @current_mission&.id, astronaut_id: @astronaut&.id) %>"
     data-health-charts-url-value="<%= chart_data_api_health_readings_path(mission_id: @current_mission&.id, astronaut_id: @astronaut&.id) %>">

  <%# ---------- Cabecera ---------- %>
  <header class="mb-6 flex flex-col gap-4 rounded-2xl border border-slate-800 bg-slate-900/60 p-5 shadow-xl shadow-black/20 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-400">NASA HRP · Monitor de salud en vuelo</p>
      <h1 class="mt-1 text-2xl font-bold tracking-tight text-white">Astronaut Health</h1>
      <p class="mt-1 text-sm text-slate-400">
        <%= @astronaut ? "#{@astronaut.name} · #{@astronaut.mission.name}" : "Sin astronauta: ejecuta rails db:seed" %>
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <span class="inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-sm font-medium <%= status_pill[overall] %>"
            data-body-3d-target="overall">
        <span class="inline-block h-2 w-2 rounded-full <%= status_dot[overall] %>"></span>
        Estado general: <span class="font-semibold uppercase"><%= status_label_es(overall) %></span>
        <% if alert_zones.any? %>
          <span class="text-xs font-normal opacity-80">
            · <%= overall == "red" ? "zonas críticas" : "zonas en vigilancia" %>: <%= alert_zone_names %>
          </span>
        <% end %>
      </span>
      <span class="inline-flex items-center gap-2 rounded-full border border-cyan-500/40 bg-cyan-500/10 px-3 py-1.5 text-sm text-cyan-200">
        ⭐ <span data-body-3d-target="points"><%= @astronaut&.total_points || 0 %></span> pts
      </span>
      <%= render "dashboard/offline_badge" %>
      <button type="button"
              data-action="click->health-form#open"
              class="rounded-xl bg-cyan-500 px-4 py-2 text-sm font-semibold text-slate-950 shadow-lg shadow-cyan-500/20 transition hover:bg-cyan-400">
        + Registrar nueva medición
      </button>
    </div>
  </header>

  <%# ---------- Selector de misión / astronauta ---------- %>
  <section class="mb-5 rounded-2xl border border-slate-800 bg-slate-900/60 p-4 shadow-xl">
    <%= form_with url: root_path, method: :get, data: { turbo: false }, class: "flex flex-col gap-3 sm:flex-row sm:items-end" do |form| %>
      <div class="flex-1">
        <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-500">Misión</label>
        <select name="mission_id"
                data-mission-selector-target="mission"
                data-action="change->mission-selector#missionChanged"
                class="w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100 outline-none focus:border-cyan-500">
          <% @missions.each do |mission| %>
            <option value="<%= mission.id %>" <%= "selected" if mission.id == @current_mission&.id %>>
              <%= mission.name %> (<%= mission.code %>)
            </option>
          <% end %>
        </select>
      </div>

      <div class="flex-1">
        <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-500">Astronauta</label>
        <select name="astronaut_id"
                data-mission-selector-target="astronaut"
                data-action="change->mission-selector#astronautChanged"
                class="w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100 outline-none focus:border-cyan-500">
          <% if @astronauts.any? %>
            <% @astronauts.each do |astronaut| %>
              <option value="<%= astronaut.id %>" <%= "selected" if astronaut.id == @astronaut&.id %>><%= astronaut.name %></option>
            <% end %>
          <% else %>
            <option value="">Sin astronautas en esta misión</option>
          <% end %>
        </select>
      </div>

      <button type="submit"
              class="rounded-xl border border-cyan-500/40 bg-cyan-500/10 px-4 py-2 text-sm font-semibold text-cyan-200 hover:bg-cyan-500/20">
        Cambiar selección
      </button>
    <% end %>
  </section>

  <%# ---------- Cuerpo 3D + panel lateral ---------- %>
  <section class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_390px]">
    <%# Columna izquierda: modelo 3D + panel de riesgos NASA HRP %>
    <div class="flex flex-col gap-5">
    <div class="relative overflow-hidden rounded-2xl border border-slate-800 bg-gradient-to-b from-slate-900 to-slate-950 shadow-xl">
      <div class="pointer-events-none absolute left-4 top-4 z-10 rounded-xl border border-slate-700/70 bg-slate-950/70 px-3 py-2 text-xs text-slate-300 backdrop-blur">
        <p class="font-semibold text-slate-100">Cuerpo interactivo</p>
        <p>Colores anatómicos originales · arrastra para rotar · rueda para zoom</p>
        <p class="mt-0.5 text-cyan-300">Click en una zona para colocar el círculo de selección</p>
      </div>
      <div class="pointer-events-none absolute bottom-4 left-4 z-10 flex items-center gap-3 rounded-xl border border-slate-700/70 bg-slate-950/70 px-3 py-2 text-xs text-slate-300 backdrop-blur">
        <span class="inline-flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-emerald-400"></span>Normal</span>
        <span class="inline-flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-amber-400"></span>Vigilar</span>
        <span class="inline-flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-rose-400"></span>Crítico</span>
      </div>
      <div data-body-3d-target="canvas" class="relative h-[520px] w-full sm:h-[620px]">
        <div data-body-3d-target="loader" class="absolute inset-0 z-10 grid place-items-center bg-slate-950/30">
          <p class="rounded-xl border border-slate-700/70 bg-slate-950/80 px-4 py-2 text-sm text-slate-300">
            Cargando modelo anatómico…
          </p>
        </div>
      </div>
      <p class="pointer-events-none absolute bottom-4 right-4 z-10 text-[10px] text-slate-500">
        Modelo:
        <a href="https://sketchfab.com/3d-models/ecorche-anatomy-study-e402d3d541eb4b199c57d5410f5d3c57"
           target="_blank" rel="noopener" class="pointer-events-auto hover:text-slate-300">Ecorche - Anatomy study</a>
        · Beatriz Gómez · CC BY 4.0
      </p>
      <div class="pointer-events-none absolute inset-x-0 bottom-0 z-0 h-24 bg-gradient-to-t from-slate-950 to-transparent"></div>
    </div>

    <%= render "dashboard/hrp_risks", risks: @hrp_risks %>
    </div>

    <aside class="flex flex-col rounded-2xl border border-slate-800 bg-slate-900/60 p-5 shadow-xl">
      <div data-body-3d-target="panel">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Detalle de zona</p>
      <h2 class="mt-2 text-lg font-semibold text-white">Selecciona una zona del cuerpo</h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-400">
        Haz click en cabeza, tórax, abdomen o extremidades para ver los indicadores asociados, su estado y la recomendación operativa.
      </p>

      <div class="mt-5 space-y-2">
        <% Array(@snapshot&.dig(:zones)).each do |zone| %>
          <div class="flex items-center justify-between gap-3 rounded-xl border border-slate-800 bg-slate-950/50 px-3 py-2.5">
            <span class="text-sm text-slate-300"><%= zone_labels[zone[:name]] || zone[:name] %></span>
            <span class="inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 text-[11px] font-semibold uppercase <%= status_pill[zone[:status]] %>">
              <span class="h-1.5 w-1.5 rounded-full <%= status_dot[zone[:status]] %>"></span><%= status_label_es(zone[:status]) %>
            </span>
          </div>
        <% end %>
      </div>

      <div class="mt-5 rounded-xl border border-cyan-500/20 bg-cyan-500/5 p-3 text-xs leading-relaxed text-cyan-100/90">
        <p>El estado general toma el peor indicador de la peor zona: si el tórax está crítico, el conjunto se marca crítico aunque otra zona esté en vigilancia.</p>
        <p class="mt-1">Los colores de cada zona reflejan su peor indicador. Un solo valor rojo activa revisión del Flight Surgeon.</p>
      </div>
      </div>

      <div class="mt-auto pt-5">
        <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Últimos eventos</p>
        <ol class="mt-3 space-y-2">
          <% @recent_readings.first(5).each do |reading| %>
            <li class="flex items-start gap-2.5 rounded-xl border border-slate-800 bg-slate-950/50 p-2.5">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full <%= status_dot[reading.status] %>"></span>
              <div class="min-w-0 flex-1">
                <p class="truncate text-xs font-medium text-slate-300"><%= reading.indicator_label %></p>
                <p class="mt-0.5 text-[11px] text-slate-400"><%= reading.value %> <%= reading.unit %> · <%= relative_time_es(reading.measured_at) %></p>
              </div>
              <span class="inline-flex shrink-0 items-center rounded-full border px-2 py-0.5 text-[10px] font-semibold uppercase <%= status_pill[reading.status] %>">
                <%= status_label_es(reading.status) %>
              </span>
            </li>
          <% end %>
          <% if @recent_readings.empty? %>
            <li class="rounded-xl border border-dashed border-slate-700 p-3 text-xs text-slate-400">Sin eventos recientes.</li>
          <% end %>
        </ol>
      </div>
    </aside>
  </section>

  <%# ---------- Gráficas + gamificación ---------- %>
  <section class="mt-5 grid gap-5 lg:grid-cols-[minmax(0,1fr)_390px]">
    <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5 shadow-xl">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Tendencia</p>
          <h2 class="mt-1 text-lg font-semibold text-white">Evolución de indicadores</h2>
        </div>
        <select data-health-charts-target="select"
                data-action="change->health-charts#renderSelected"
                class="rounded-xl border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-200 outline-none focus:border-cyan-500">
          <option value="">Cargando indicadores…</option>
        </select>
      </div>
      <div class="mt-4 h-[300px]">
        <canvas data-health-charts-target="canvas"></canvas>
      </div>
      <p data-health-charts-target="empty" class="mt-2 hidden text-sm text-slate-500">
        Aún no hay suficientes mediciones. Registra una nueva medición para ver la gráfica.
      </p>
    </div>

    <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5 shadow-xl">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Gamificación</p>
      <h2 class="mt-1 text-lg font-semibold text-white">Logros de misión</h2>
      <p class="mt-1 text-sm text-slate-400">
        Puntos totales: <span class="font-semibold text-cyan-300"><%= @astronaut&.total_points || 0 %></span>
      </p>

      <div class="mt-4 space-y-2">
        <% @achievements.each do |achievement| %>
          <div class="rounded-xl border border-emerald-500/30 bg-emerald-500/5 p-3">
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm font-medium text-emerald-200"><%= achievement.name %></p>
              <span class="text-xs font-semibold text-emerald-300">+<%= achievement.points %> pts</span>
            </div>
            <p class="mt-1 text-xs text-slate-400"><%= achievement.description %></p>
          </div>
        <% end %>

        <% if @achievements.empty? %>
          <p class="rounded-xl border border-dashed border-slate-700 p-3 text-xs text-slate-500">
            Aún no tienes logros. Completa un chequeo diario con todos los indicadores.
          </p>
        <% end %>
      </div>

      <% if @next_achievements.any? %>
        <p class="mt-4 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Próximos logros</p>
        <ul class="mt-2 space-y-1 text-xs text-slate-400">
          <% @next_achievements.each do |achievement| %>
            <li class="flex items-center justify-between gap-2">
              <span><%= achievement.name %></span>
              <span class="text-slate-500">+<%= achievement.points %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </section>

  <%# ---------- Últimas mediciones ---------- %>
  <section class="mt-5 rounded-2xl border border-slate-800 bg-slate-900/60 p-5 shadow-xl">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-semibold text-white">Últimas mediciones</h2>
      <%= link_to "Ver historial completo", health_readings_path(mission_id: @current_mission&.id, astronaut_id: @astronaut&.id), class: "text-sm text-cyan-400 hover:text-cyan-300" %>
    </div>

    <div class="mt-4 overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-800 text-sm">
        <thead>
          <tr class="text-left text-xs uppercase tracking-wider text-slate-500">
            <th class="pb-2 pr-4 font-medium">Indicador</th>
            <th class="pb-2 pr-4 font-medium">Valor</th>
            <th class="pb-2 pr-4 font-medium">Estado</th>
            <th class="pb-2 font-medium">Fecha</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/70" data-health-charts-target="tableBody">
          <% @recent_readings.each do |reading| %>
            <tr>
              <td class="py-2.5 pr-4 text-slate-300"><%= reading.indicator_label %></td>
              <td class="py-2.5 pr-4 font-medium text-slate-100"><%= reading.value %> <span class="text-xs text-slate-500"><%= reading.unit %></span></td>
              <td class="py-2.5 pr-4">
                <span class="inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 text-[11px] font-semibold uppercase <%= status_pill[reading.status] %>">
                  <span class="h-1.5 w-1.5 rounded-full <%= status_dot[reading.status] %>"></span><%= status_label_es(reading.status) %>
                </span>
              </td>
              <td class="py-2.5 text-slate-400"><%= reading.measured_at.strftime("%d/%m/%Y %H:%M") %></td>
            </tr>
          <% end %>
          <% if @recent_readings.empty? %>
            <tr><td colspan="4" class="py-4 text-center text-slate-500">Sin mediciones todavía.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <%# ---------- Modal de nueva medición ---------- %>
  <div data-health-form-target="modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 p-4 backdrop-blur-sm">
    <div class="w-full max-w-lg rounded-2xl border border-slate-700 bg-slate-900 p-6 shadow-2xl">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-cyan-400">Nueva medición</p>
          <h2 class="mt-1 text-xl font-semibold text-white">Registrar indicador</h2>
        </div>
        <button type="button" data-action="click->health-form#close"
                class="rounded-lg border border-slate-700 px-2.5 py-1 text-sm text-slate-400 hover:bg-slate-800">✕</button>
      </div>

      <form data-health-form-target="form" data-action="submit->health-form#submit" class="mt-5 space-y-4">
        <div>
          <label class="mb-1 block text-sm font-medium text-slate-300" for="health_reading_indicator_type">Indicador</label>
          <select name="health_reading[indicator_type]" id="health_reading_indicator_type"
                  data-health-form-target="indicator" data-action="change->health-form#updateUnit"
                  class="w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-slate-100 outline-none focus:border-cyan-500">
            <% @indicator_options.each do |type, config| %>
              <option value="<%= type %>" data-unit="<%= config[:unit] %>"><%= config[:label] %> (<%= config[:unit] %>)</option>
            <% end %>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="mb-1 block text-sm font-medium text-slate-300" for="health_reading_value">Valor</label>
            <input type="number" step="0.1" name="health_reading[value]" id="health_reading_value" required
                   data-health-form-target="value"
                   class="w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-slate-100 outline-none focus:border-cyan-500">
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-slate-300" for="health_reading_unit">Unidad</label>
            <input type="text" name="health_reading[unit]" id="health_reading_unit"
                   data-health-form-target="unit" value="<%= @indicator_options.values.first[:unit] %>"
                   class="w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-slate-100 outline-none focus:border-cyan-500">
          </div>
        </div>

        <div>
          <label class="mb-1 block text-sm font-medium text-slate-300" for="health_reading_measured_at">Fecha y hora (opcional)</label>
          <input type="datetime-local" name="health_reading[measured_at]" id="health_reading_measured_at"
                 class="w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-slate-100 outline-none focus:border-cyan-500">
        </div>

        <p data-health-form-target="error" class="hidden rounded-xl border border-rose-500/30 bg-rose-500/10 px-3 py-2 text-sm text-rose-200"></p>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button type="button" data-action="click->health-form#close"
                  class="rounded-xl border border-slate-700 px-4 py-2 text-sm text-slate-300 hover:bg-slate-800">Cancelar</button>
          <button type="submit" data-health-form-target="submitButton"
                  class="rounded-xl bg-cyan-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-cyan-400 disabled:cursor-not-allowed disabled:opacity-60">
            Guardar medición
          </button>
        </div>
      </form>
    </div>
  </div>

  <%# Modal SOS (se abre desde el panel lateral cuando la zona está crítica) %>
  <%= render "dashboard/sos_modal" %>

  <%# Toast de avisos de enlace / modo offline %>
  <%= render "dashboard/offline_toast" %>

  <%# Toast de logros / confirmación %>
  <div data-health-form-target="toast"
       class="pointer-events-none fixed bottom-6 right-6 z-[60] hidden max-w-sm rounded-2xl border border-emerald-500/40 bg-emerald-500/15 px-4 py-3 text-sm text-emerald-100 shadow-2xl backdrop-blur">
    <p data-health-form-target="toastTitle" class="font-semibold"></p>
    <p data-health-form-target="toastBody" class="mt-0.5 text-xs text-emerald-100/80"></p>
  </div>

  <%# Créditos, licencias y disclaimer (cumplimiento NASA) %>
  <%= render "dashboard/credits_footer" %>
</div>
