  <%# ---------- New measurement modal ---------- %>
  <div data-health-form-target="modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 p-4 backdrop-blur-sm">
    <div class="w-full max-w-lg rounded-2xl border border-slate-700 bg-slate-900 p-6 shadow-2xl">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-cyan-400">New measurement</p>
          <h2 class="mt-1 text-xl font-semibold text-white">Register indicator</h2>
        </div>
        <button type="button" data-action="click->health-form#close"
                class="rounded-lg border border-slate-700 px-2.5 py-1 text-sm text-slate-400 hover:bg-slate-800">✕</button>
      </div>

      <form data-health-form-target="form" data-action="submit->health-form#submit" class="mt-5 space-y-4">
        <input type="hidden" name="health_reading[confirmed]" value="0" data-health-form-target="confirmed">

        <div>
          <label class="mb-1 block text-sm font-medium text-slate-300" for="health_reading_indicator_type">Indicator</label>
          <select name="health_reading[indicator_type]" id="health_reading_indicator_type"
                  data-health-form-target="indicator" data-action="change->health-form#updateUnit"
                  class="w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-slate-100 outline-none focus:border-cyan-500">
            <% @indicator_options.each do |type, config| %>
              <% plausibility = HealthReading.plausibility_range_for(type) %>
              <% confirmation = HealthReading.confirmation_range_for(type) || {} %>
              <% expected = HealthReading.expected_range_for(type) %>
              <option value="<%= type %>"
                      data-unit="<%= config[:unit] %>"
                      data-units="<%= HealthReading.unit_options_for(type).join(',') %>"
                      data-plausibility-min="<%= plausibility&.min %>"
                      data-plausibility-max="<%= plausibility&.max %>"
                      data-confirm-low="<%= confirmation[:low] %>"
                      data-confirm-high="<%= confirmation[:high] %>"
                      data-expected-min="<%= expected&.min %>"
                      data-expected-max="<%= expected&.max %>"
                      data-guide="<%= HealthReading::GUIDES[type] %>"
                      data-citation="<%= HealthReading::CITATIONS[type] %>">
                <%= config[:label] %> (<%= config[:unit] %>)
              </option>
            <% end %>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="mb-1 block text-sm font-medium text-slate-300" for="health_reading_value">Value</label>
            <input type="number" step="0.1" name="health_reading[value]" id="health_reading_value" required
                   data-health-form-target="value"
                   class="w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-slate-100 outline-none focus:border-cyan-500">
            <p data-health-form-target="valueError" class="mt-1 hidden text-xs text-rose-300"></p>
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-slate-300" for="health_reading_unit">Unit</label>
            <select name="health_reading[unit]" id="health_reading_unit"
                    data-health-form-target="unit" data-action="change->health-form#convertValue"
                    class="w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-slate-100 outline-none focus:border-cyan-500">
              <% HealthReading::UNIT_CHOICES.each do |unit| %>
                <option value="<%= unit %>"><%= unit %></option>
              <% end %>
            </select>
          </div>
        </div>

        <p data-health-form-target="help" class="text-[11px] leading-relaxed text-slate-500"></p>

        <div>
          <label class="mb-1 block text-sm font-medium text-slate-300" for="health_reading_data_origin">Data origin</label>
          <select name="health_reading[data_origin]" id="health_reading_data_origin"
