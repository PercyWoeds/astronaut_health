    <%# ---------- Latest measurements ---------- %>
    <section class="mt-5 rounded-2xl border border-slate-700 bg-slate-900/60 p-5 shadow-xl">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-white">Latest Measurements</h2>
        <div class="flex items-center gap-3">
          <% if @recent_readings.any? %>
            <%= button_to "Undo last reading", health_reading_path(@recent_readings.first, mission_id: @current_mission&.id, astronaut_id: @astronaut&.id),
                  method: :delete,
                  form: { onsubmit: "return confirm('Undo the last reading? This cannot be undone.')" },
                  class: "rounded-xl border border-rose-500/40 px-3 py-2 text-xs font-semibold text-rose-300 hover:bg-rose-500/10" %>
          <% end %>
          <%= link_to "View full history", health_readings_path(mission_id: @current_mission&.id, astronaut_id: @astronaut&.id), class: "text-sm text-cyan-400 hover:text-cyan-300" %>
