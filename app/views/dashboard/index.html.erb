            <tr class="text-left text-xs uppercase tracking-wider text-slate-500">
              <th class="pb-2 pr-4 font-medium">Indicator</th>
              <th class="pb-2 pr-4 font-medium">Value</th>
              <th class="pb-2 pr-4 font-medium">Status</th>
              <th class="pb-2 font-medium">Date</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/70" data-health-charts-target="tableBody">
            <% @recent_readings.each do |reading| %>
              <tr>
                <td class="py-2.5 pr-4 text-slate-300">
                  <%= reading.indicator_label %>
                  <span class="mt-0.5 block text-[10px] text-slate-500"><%= reference_scope_label(reading.indicator_type) %></span>
                  <% if reading.is_baseline? %>
                    <span class="ml-1 rounded-full border border-cyan-500/40 bg-cyan-500/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase text-cyan-200">pre</span>
                  <% end %>
                  <% if reading.confirmed? %>
                    <span class="ml-1 rounded-full border border-rose-500/40 bg-rose-500/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase text-rose-200">confirmed</span>
                  <% end %>
                  <span class="mt-1 block text-[10px] text-slate-500">Origin: <%= reading.data_origin_label %></span>
                </td>
                <td class="py-2.5 pr-4 font-medium text-slate-100"><%= reading.value %> <span class="text-xs text-slate-500"><%= reading.unit %></span></td>
                <td class="py-2.5 pr-4">
                  <span class="inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 text-[11px] font-semibold uppercase <%= status_pill[reading.status] %>">
                    <span class="h-1.5 w-1.5 rounded-full <%= status_dot[reading.status] %>"></span>
                    <span aria-hidden="true"><%= status_icon(reading.status) %></span><%= reading_alert_label(reading) %>
                  </span>
                </td>
                <td class="py-2.5 text-slate-400"><%= reading.measured_at.strftime("%d/%m/%Y %H:%M") %></td>
              </tr>
            <% end %>
            <% if @recent_readings.empty? %>
              <tr><td colspan="4" class="py-4 text-center text-slate-500">No measurements yet.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <%# ================= TAB 3: Charts & History ================= %>
  <div data-tabs-target="content" data-tab="Symptom" class="mt-5 hidden">
 
 
 
 
    <%# ---------- Operational status above the 3D model ---------- %>
    <section class="mb-5 grid gap-5 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]">
      <div class="rounded-2xl border border-slate-700 bg-slate-900/60 p-5 shadow-xl">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Operational Status</p>
            <h2 class="mt-1 text-lg font-semibold text-white">Action Protocol</h2>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider <%= status_pill[overall] %>">
              <span class="h-1.5 w-1.5 rounded-full <%= status_dot[overall] %>"></span><%= status_label_es(overall) %>
            </span>
            <% if @astronaut %>
              <button type="button" data-action="click->health-form#open"
                      class="rounded-xl border border-cyan-500/40 bg-cyan-500/10 px-4 py-2 text-sm font-semibold text-cyan-200 transition hover:bg-cyan-500/20">
                ➕ Register Measurement
              </button>
            <% end %>
          </div>
        </div>

        <div class="mt-3 rounded-xl border border-slate-700 bg-slate-950/50 px-3 py-2.5">
          <p class="text-[10px] font-semibold uppercase tracking-wider text-cyan-400">Comms &amp; autonomy</p>
          <p data-environment-target="protocol" class="mt-1 text-sm font-medium text-gray-200"><%= CommDelay.protocol_for(@astronaut&.destination || "iss") %></p>
        </div>

        <% if @astronaut %>
          <% if overall == "red" %>
            <div class="mt-3 rounded-xl border border-rose-500/40 bg-rose-500/10 p-3">
              <p class="text-[11px] font-semibold uppercase tracking-wider text-rose-300">Medical evaluation zone detected</p>
              <p class="mt-1 text-xs leading-relaxed text-rose-200">
                <%= alert_zone_names.presence || "A monitored zone requires medical evaluation" %>.
              </p>
              <ol class="mt-2 list-decimal space-y-0.5 pl-4 text-xs leading-relaxed text-rose-200">
                <li>Re-measure in 5 min.</li>
                <li>If it persists, report.</li>
              </ol>
              <%= form_with url: ground_reports_path, method: :post, class: "mt-2" do |form| %>
                <%= hidden_field_tag :astronaut_id, @astronaut.id %>
                <%= hidden_field_tag :summary, "Automatic report: a monitored zone requires medical evaluation — #{@astronaut.name}" %>
                <%= form.submit "🚨 Report to Flight Surgeon", class: "w-full rounded-xl border border-rose-500/40 bg-rose-500/10 px-4 py-2 text-sm font-semibold text-rose-200 hover:bg-rose-500/20" %>
              <% end %>
            </div>
          <% elsif overall == "yellow" %>
            <div class="mt-3 rounded-xl border border-amber-500/30 bg-amber-500/10 p-3">
              <p class="text-[11px] font-semibold uppercase tracking-wider text-amber-300">Zones under watch</p>
              <p class="mt-1 text-xs leading-relaxed text-amber-200">
                <%= alert_zone_names.presence || "Some zones need a follow-up measurement" %>. Continue monitoring and repeat the measurement if needed.
              </p>
            </div>
          <% else %>
            <div class="mt-3 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3">
              <p class="text-[11px] font-semibold uppercase tracking-wider text-emerald-300">All zones nominal</p>
              <p class="mt-1 text-xs leading-relaxed text-emerald-200">No zones require medical evaluation. Continue routine monitoring.</p>
            </div>
          <% end %>
        <% end %>

        <p class="mt-3 text-[11px] leading-relaxed text-slate-400">
          The recommendation is advisory.
        </p>
      </div>

      <% if @astronaut %>
        <%= render "dashboard/symptom_check_card" %>
      <% else %>
        <div class="rounded-2xl border border-slate-700 bg-slate-900/60 p-5 shadow-xl">
          <p class="text-sm text-slate-400">Run rails db:seed to load the demo scenario.</p>
        </div>
      <% end %>
    </section>
    
    

    <%# ---------- Latest measurements ---------- %>

    
    
    
