<% status_pill = {
  "green" => "bg-emerald-500/15 text-emerald-300 border-emerald-500/40",
  "yellow" => "bg-amber-500/15 text-amber-300 border-amber-500/40",
  "red" => "bg-rose-500/15 text-rose-300 border-rose-500/40"
} %>
<% status_dot = { "green" => "bg-emerald-400", "yellow" => "bg-amber-400", "red" => "bg-rose-400" } %>
<% overall = @snapshot&.dig(:overall_status) || "green" %>
<% zone_labels = { "head" => "Head", "chest" => "Chest", "abdomen" => "Abdomen", "limbs" => "Limbs", "psychological" => "Psychological zone", "immune" => "Immune system" } %>
<% all_zones = Array(@snapshot&.dig(:zones)) %>
<% alert_zones = all_zones.select { |zone| zone[:status] == overall } %>
<% alert_zone_names = alert_zones.map { |zone| zone_labels[zone[:name]] || zone[:name] }.join(", ") %>
<% overall_detail = if overall == "green"
     "All #{all_zones.size} zones normal"
   else
      "#{alert_zones.size} zone#{'s' unless alert_zones.size == 1} #{overall == 'red' ? 'needs medical evaluation' : 'needs follow-up'}"
   end %>
<% health_score = @health_score.to_i %>
<% health_score_tone = if health_score > 90
     "border-emerald-400 text-emerald-300"
   elsif health_score >= 70
     "border-amber-400 text-amber-300"
   else
     "border-rose-400 text-rose-300"
   end %>
<% overall_tone = { "green" => "border-emerald-400 text-emerald-300", "yellow" => "border-amber-400 text-amber-300", "red" => "border-rose-400 text-rose-300" }[overall] %>
<% solar_events = Array(@space_weather_events) %>
<% solar_alert = solar_events.any? %>
<% main_recommendation = @rule_based_recommendations.first.presence || RuleBasedFlightSurgeon::NOMINAL_RECOMMENDATION %>

<% content_for :head do %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<% end %>

<div class="mx-auto max-w-7xl rounded-3xl px-4 py-6 transition-shadow duration-500 lg:px-8"
     data-body-3d-target="alert"
     data-controller="tabs body-3d health-form health-charts mission-selector offline sos hrp-risks environment disclosure"
     data-body-3d-url-value="<%= api_health_status_path(mission_id: @current_mission&.id, astronaut_id: @astronaut&.id) %>"
     data-health-form-url-value="<%= health_readings_path(mission_id: @current_mission&.id, astronaut_id: @astronaut&.id) %>"
     data-offline-url-value="<%= health_readings_path(mission_id: @current_mission&.id, astronaut_id: @astronaut&.id) %>"
     data-hrp-risks-url-value="<%= api_hrp_risks_path(mission_id: @current_mission&.id, astronaut_id: @astronaut&.id) %>"
     data-environment-delays-value="<%= @comm_delays.to_json %>"
     data-health-charts-url-value="<%= chart_data_api_health_readings_path(mission_id: @current_mission&.id, astronaut_id: @astronaut&.id) %>">

  <%# ---------- Flash notices ---------- %>
  <% if notice.present? %>
    <div class="mb-4 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200"><%= notice %></div>
  <% end %>
  <% if alert.present? %>
    <div class="mb-4 rounded-xl border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200"><%= alert %></div>
  <% end %>

  <% if @pending_measurements&.any? %>
    <div class="mb-4 rounded-xl border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-200">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="font-semibold">You have <%= @pending_measurements.size %> pending measurements today:</p>
      </div>
      <ul class="mt-2 flex flex-wrap gap-2">
        <% @pending_measurements.each do |type| %>
          <% config = HealthReading::INDICATORS[type] || {} %>
          <li>
            <button type="button"
                    data-action="click->health-form#openFor"
                    data-health-form-indicator-param="<%= type %>"
                    class="rounded-full border border-amber-500/30 bg-amber-500/10 px-2.5 py-1 text-xs text-amber-100 hover:bg-amber-500/20">
              <%= config[:label] || type %>
              <span class="text-amber-300/70">(<%= config[:unit] %>)</span>
            </button>
          </li>
        <% end %>
      </ul>
      <p class="mt-2 text-[11px] text-amber-200/70">Click a measurement to open the form with that indicator preselected.</p>
    </div>
  <% end %>

  <%# ---------- Header ---------- %>
  <header class="mb-6 flex flex-col gap-4 rounded-2xl border border-slate-700 bg-slate-900/60 p-5 shadow-xl shadow-black/20 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-400">NASA HRP · In-Flight Health Monitor</p>
      <h1 class="mt-1 text-2xl font-bold tracking-tight text-white">Quipu Health</h1>
      <p class="mt-1 text-sm text-slate-400">
        <%= @astronaut ? "#{@astronaut.name} · #{@astronaut.mission.name}" : "No astronaut: run rails db:seed" %>
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <span class="inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-sm font-medium <%= status_pill[overall] %>"
            data-body-3d-target="overall">
        <span class="inline-block h-2 w-2 rounded-full <%= status_dot[overall] %>"></span>
        Overall status: <span class="font-semibold uppercase"><%= status_label_es(overall) %></span>
        <% if alert_zones.any? && overall != "green" %>
          <span class="text-xs font-normal opacity-80">
            · <%= overall == "red" ? "zones needing medical evaluation" : "zones needing follow-up" %>: <%= alert_zone_names %>
          </span>
        <% end %>
      </span>
      <span class="inline-flex items-center gap-2 rounded-full border border-cyan-500/40 bg-cyan-500/10 px-3 py-1.5 text-sm text-cyan-200">
        ⭐ <span data-body-3d-target="points"><%= @astronaut&.total_points || 0 %></span> pts
      </span>
      <%= render "dashboard/offline_badge" %>
    </div>
  </header>

  <%# ---------- Mission / astronaut selector ---------- %>
  <section class="mb-5 rounded-2xl border border-slate-700 bg-slate-900/60 p-4 shadow-xl">
    <%= form_with url: root_path, method: :get, data: { turbo: false }, class: "flex flex-col gap-3 sm:flex-row sm:items-end" do |form| %>
      <div class="flex-1">
        <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-500">Mission</label>
        <select name="mission_id"
                data-mission-selector-target="mission"
                data-action="change->mission-selector#missionChanged"
                class="w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100 outline-none focus:border-cyan-500">
          <% @missions.each do |mission| %>
            <option value="<%= mission.id %>" <%= "selected" if mission.id == @current_mission&.id %>>
              <%= mission.name %> (<%= mission.code %>)
            </option>
          <% end %>
        </select>
      </div>

      <div class="flex-1">
        <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-500">Astronaut</label>
        <select name="astronaut_id"
                data-mission-selector-target="astronaut"
                data-action="change->mission-selector#astronautChanged"
                class="w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100 outline-none focus:border-cyan-500">
          <% if @astronauts.any? %>
            <% @astronauts.each do |astronaut| %>
              <option value="<%= astronaut.id %>" <%= "selected" if astronaut.id == @astronaut&.id %>><%= astronaut.name %></option>
            <% end %>
          <% else %>
            <option value="">No astronauts in this mission</option>
          <% end %>
        </select>
      </div>

      <button type="submit"
              class="rounded-xl border border-cyan-500/40 bg-cyan-500/10 px-4 py-2 text-sm font-semibold text-cyan-200 hover:bg-cyan-500/20">
        Change selection
      </button>
    <% end %>
  </section>

  <%# ---------- Tabs ---------- %>
  <nav class="flex flex-wrap gap-1 border-b border-slate-700" role="tablist" aria-label="Dashboard sections">
    <button type="button" role="tab" aria-selected="true"
            data-tabs-target="tab" data-tab="vitals" data-action="click->tabs#switch"
            class="border-b-2 border-cyan-500 px-4 py-2.5 text-sm font-semibold text-white transition">
      🫀 Vitals &amp; Body
    </button>
    <button type="button" role="tab" aria-selected="false"
            data-tabs-target="tab" data-tab="risks" data-action="click->tabs#switch"
            class="border-b-2 border-transparent px-4 py-2.5 text-sm font-medium text-slate-400 transition hover:text-slate-200">
      ⚠️ Mission Risks &amp; Studies
    </button>
    <button type="button" role="tab" aria-selected="false"
            data-tabs-target="tab" data-tab="charts" data-action="click->tabs#switch"
            class="border-b-2 border-transparent px-4 py-2.5 text-sm font-medium text-slate-400 transition hover:text-slate-200">
      📈 Charts &amp; History
    </button>

      <button type="button" role="tab" aria-selected="false"
            data-tabs-target="tab" data-tab="Symptom" data-action="click->tabs#switch"
            class="border-b-2 border-transparent px-4 py-2.5 text-sm font-medium text-slate-400 transition hover:text-slate-200">
      🧭 Actions &amp; Symptoms
    </button>
  </nav>

  <%# ================= TAB 1: Vitals & Body ================= %>
  <div data-tabs-target="content" data-tab="vitals" class="mt-5">
    <%# ---------- Summary strip (moved above the 3D model, original card format) ---------- %>
    <section class="mb-5 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      <%# 1. Crew Health Score + Why? ---------- %>
      <div class="rounded-2xl border border-cyan-900 bg-gray-800 p-5 font-mono shadow-xl" data-controller="disclosure">
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-cyan-300">🩺 Crew Health Score</h2>
          <button type="button" data-action="click->disclosure#toggle" data-disclosure-button aria-expanded="false"
                  class="rounded-full border border-gray-700 px-2 py-0.5 text-[10px] font-semibold text-cyan-300 transition hover:border-cyan-500 hover:text-cyan-200">
            <span data-disclosure-target="label" data-closed-label="Why?" data-open-label="Hide">Why?</span>
          </button>
        </div>
        <div class="mt-4 flex justify-center">
          <div class="flex h-32 w-32 items-center justify-center rounded-full border-4 <%= health_score_tone %>">
            <span class="text-4xl font-bold"><%= health_score %></span>
          </div>
        </div>
        <% if @health_score_capped %>
          <p class="mt-2 text-center text-[10px] font-semibold uppercase tracking-wider text-rose-300">Medical evaluation zone present</p>
        <% end %>
        <p class="mt-3 text-center text-[11px] leading-relaxed text-gray-400">
          Based on sleep, mood, systolic and diastolic BP, glucose and DONKI solar alerts.
        </p>

        <div data-disclosure-target="panel" class="mt-3 hidden rounded-lg border border-gray-700 bg-gray-900 p-2.5">
          <% if @health_score_capped %>
            <p class="mb-2 rounded-md border border-rose-500/30 bg-rose-500/10 px-2 py-1 text-[10px] leading-snug text-rose-200">
              Score capped at <%= health_score %> while a zone requires medical evaluation.
            </p>
          <% end %>
          <% if @health_score_discounts.any? %>
            <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-500">Deductions</p>
            <ul class="mt-1.5 space-y-1">
              <% @health_score_discounts.each do |discount| %>
                <li class="flex items-center justify-between gap-2 text-[11px] text-gray-300">
                  <span>
                    <%= discount[:label] %>
                    <span class="text-gray-500">· <%= discount[:detail] %></span>
                  </span>
                  <span class="shrink-0 font-semibold text-rose-300">−<%= discount[:points] %></span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-[11px] text-gray-400">No deductions — all monitored factors are nominal.</p>
          <% end %>
        </div>
      </div>

      <%# 2. Overall Status ---------- %>
      <div class="rounded-2xl border border-cyan-900 bg-gray-800 p-5 font-mono shadow-xl">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-cyan-300">🚦 Overall Status</h2>
        <div class="mt-4 flex justify-center">
          <div class="flex h-32 w-32 flex-col items-center justify-center rounded-full border-4 <%= overall_tone %>">
            <span class="text-2xl font-bold"><%= status_label_es(overall) %></span>
            <span class="mt-0.5 text-[10px] uppercase tracking-wider opacity-80"><%= alert_zones.size %> zone<%= "s" unless alert_zones.size == 1 %></span>
          </div>
        </div>
        <p class="mt-3 text-center text-[11px] leading-relaxed text-gray-400"><%= overall_detail %></p>
      </div>

      <%# 3. Main Action (top Flight Surgeon recommendation) ---------- %>
      <div class="rounded-2xl border border-cyan-900 bg-gray-800 p-5 font-mono shadow-xl">
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-cyan-300">🧠 Main Action</h2>
          <span class="text-[10px] uppercase tracking-wider text-gray-500">Flight Surgeon</span>
        </div>
        <div class="mt-4 rounded-lg border border-gray-700 bg-gray-900 p-2.5 text-xs leading-relaxed text-gray-200">
          <%= main_recommendation %>
        </div>
        <button type="button" data-action="click->tabs#switch" data-tab="risks"
                class="mt-3 text-[11px] font-semibold text-cyan-300 transition hover:text-cyan-200">
          View full analysis →
        </button>
      </div>

      <%# 4. Space Weather (DONKI) ---------- %>
      <div class="rounded-2xl border border-cyan-900 bg-gray-800 p-5 font-mono shadow-xl">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-cyan-300">☀️ Space Weather (DONKI)</h2>
        <% if solar_alert %>
          <p class="mt-4 text-sm font-semibold text-rose-300">⚠️ Solar Particle Alert</p>
        <% else %>
          <p class="mt-4 text-sm font-semibold text-emerald-300">☢️ Space weather stable</p>
        <% end %>
        <p class="mt-2 text-xs text-gray-400">
          Events detected (last 7 days): <span class="font-bold text-gray-200"><%= solar_events.size %></span>
        </p>
        <p class="mt-1 text-[10px] text-gray-500">Last checked: <%= @space_weather_checked_at.utc.strftime("%H:%M UTC") %></p>
        <% if @space_weather_error.present? %>
          <p class="mt-1 text-[10px] text-amber-300">DONKI link error: <%= @space_weather_error %>. Showing no events until the next successful check.</p>
        <% end %>
      </div>
    </section>


    <%# ---------- 3D body + side panel ---------- %>
    <section class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_390px]">
      <%# Left column: 3D model + recent events %>
      <div class="flex flex-col gap-5">
        <div class="relative overflow-hidden rounded-2xl border border-slate-700 bg-gradient-to-b from-slate-900 to-slate-950 shadow-xl">
          <div class="pointer-events-none absolute left-4 top-4 z-10 rounded-xl border border-slate-700/70 bg-slate-950/70 px-3 py-2 text-xs text-slate-300 backdrop-blur">
            <p class="peer pointer-events-auto inline-block cursor-help font-semibold text-slate-100">Interactive Body Map</p>
            <p class="mt-0.5 hidden peer-hover:block">Status-tinted hologram · drag to rotate · scroll to zoom</p>
            <p class="mt-0.5 hidden text-cyan-300 peer-hover:block">Click a zone to inspect it · labels show alert counts</p>
          </div>

          <%# Camera controls: reset view and 2D fallback plan. %>
          <div class="pointer-events-none absolute right-4 top-4 z-10 flex flex-wrap justify-end gap-2">
            <button type="button" data-action="click->body-3d#resetView"
                    class="pointer-events-auto rounded-lg border border-slate-700 bg-slate-950/80 px-2.5 py-1 text-[11px] font-medium text-slate-200 backdrop-blur transition hover:border-cyan-500 hover:text-white">
              Reset view
            </button>
            <button type="button" data-action="click->body-3d#toggleFallback"
                    class="pointer-events-auto rounded-lg border border-slate-700 bg-slate-950/80 px-2.5 py-1 text-[11px] font-medium text-slate-200 backdrop-blur transition hover:border-cyan-500 hover:text-white">
              2D map
            </button>
          </div>

          <div class="pointer-events-none absolute bottom-4 left-4 z-10 flex items-center gap-3 rounded-xl border border-slate-700/70 bg-slate-950/70 px-3 py-2 text-xs text-slate-300 backdrop-blur">
            <span class="inline-flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-emerald-400"></span>Normal</span>
            <span class="inline-flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-amber-400"></span>Follow-up</span>
            <span class="inline-flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-rose-400"></span>Medical evaluation</span>
          </div>
          <div data-body-3d-target="canvas" class="relative h-[520px] w-full sm:h-[620px]">
            <div data-body-3d-target="loader" class="absolute inset-0 z-10 grid place-items-center bg-slate-950/30">
              <p class="rounded-xl border border-slate-700/70 bg-slate-950/80 px-4 py-2 text-sm text-slate-300">
                Loading anatomical model…
              </p>
            </div>
          </div>
          <div data-body-3d-target="fallback" class="hidden h-[520px] w-full overflow-y-auto p-4 sm:h-[620px]"></div>
          <p class="pointer-events-none absolute bottom-4 right-4 z-10 text-[10px] text-slate-500">
            Model:
            <a href="https://sketchfab.com/3d-models/ecorche-anatomy-study-e402d3d541eb4b199c57d5410f5d3c57"
               target="_blank" rel="noopener" class="pointer-events-auto hover:text-slate-300">Ecorche - Anatomy study</a>
            · Beatriz Gomez Santamaria · CC BY 4.0
          </p>
          <div class="pointer-events-none absolute inset-x-0 bottom-0 z-0 h-24 bg-gradient-to-t from-slate-950 to-transparent"></div>
        </div>

        <% severity_rank = { "red" => 0, "yellow" => 1, "green" => 2 } %>
        <% latest_events = @recent_readings.sort_by { |reading| [severity_rank.fetch(reading.status, 3), -reading.measured_at.to_i] }.first(5) %>
        <div class="rounded-2xl border border-slate-700 bg-slate-900/60 p-5 shadow-xl">
          <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Latest alerts · severity first</p>
          <ol class="mt-3 grid gap-2 sm:grid-cols-2">
            <% latest_events.each do |reading| %>
              <li class="flex items-start gap-2.5 rounded-xl border border-slate-700 bg-slate-950/50 p-2.5">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full <%= status_dot[reading.status] %>"></span>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-xs font-medium text-slate-300"><%= reading.indicator_label %></p>
                  <p class="mt-0.5 text-[11px] text-slate-400">
                    <%= reading.value %> <%= reading.unit %> · <%= relative_time_es(reading.measured_at) %>
                    <% if reading.baseline_note.present? %>
                      · <span class="text-cyan-300"><%= reading.baseline_note %></span>
                    <% end %>
                  </p>
                  <p class="mt-0.5 text-[10px] text-slate-500"><%= reference_scope_label(reading.indicator_type) %></p>
                </div>
                <span class="inline-flex shrink-0 items-center gap-1 rounded-full border px-2 py-0.5 text-[10px] font-semibold uppercase <%= status_pill[reading.status] %>">
                  <span aria-hidden="true"><%= status_icon(reading.status) %></span><%= reading_alert_label(reading) %>
                </span>
              </li>
            <% end %>
            <% if @recent_readings.empty? %>
              <li class="rounded-xl border border-dashed border-slate-700 p-3 text-xs text-slate-400">No recent events.</li>
            <% end %>
          </ol>
        </div>
      </div>

      <%# Right column: selected zone, limited height with its own scroll. %>
      <aside class="flex flex-col rounded-2xl border border-slate-700 bg-slate-900/60 p-5 shadow-xl lg:sticky lg:top-4 lg:max-h-[calc(100vh-2rem)] lg:overflow-y-auto">
        <div data-body-3d-target="panel">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Selected Zone</p>
          <h2 class="mt-2 text-lg font-semibold text-white">Select a body zone</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">
            Click head, chest, abdomen or limbs to see the associated indicators, their status and the operational recommendation.
          </p>

          <div class="mt-5 space-y-2">
            <% all_zones.each do |zone| %>
              <div class="flex items-center justify-between gap-3 rounded-xl border border-slate-700 bg-slate-950/50 px-3 py-2.5">
                <span class="text-sm text-slate-300"><%= zone_labels[zone[:name]] || zone[:name] %></span>
                <span class="inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 text-[11px] font-semibold uppercase <%= status_pill[zone[:status]] %>">
                  <span class="h-1.5 w-1.5 rounded-full <%= status_dot[zone[:status]] %>"></span><%= status_label_es(zone[:status]) %>
                </span>
              </div>
            <% end %>
          </div>

          <details class="mt-5 rounded-xl border border-slate-700 bg-slate-950/40 p-3 text-xs leading-relaxed text-slate-300">
            <summary class="cursor-pointer font-medium text-cyan-300">How zone status works</summary>
            <p class="mt-2">The overall status takes the worst indicator of the worst zone: if the chest requires medical evaluation, the whole set is marked that way even if another zone only needs follow-up.</p>
            <p class="mt-1">Each zone color reflects its worst indicator. A single red value triggers Flight Surgeon review, but it is not a diagnosis.</p>
          </details>
        </div>
      </aside>
    </section>
  </div>

  <%# ================= TAB 2: Mission Risks & Studies ================= %>
  <div data-tabs-target="content" data-tab="risks" class="mt-5 hidden">
    <%# Full 7-day Flight Surgeon analysis lives here (moved out of the compact strip). %>
    <section class="mb-5 rounded-2xl border border-slate-700 bg-gray-800 p-5 font-mono shadow-xl">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Rule-Based Flight Surgeon</p>
          <h2 class="mt-1 text-lg font-semibold text-white">7-day analysis</h2>
        </div>
        <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider <%= @rule_based_critical ? "border-rose-500/40 bg-rose-500/10 text-rose-200" : "border-emerald-500/40 bg-emerald-500/10 text-emerald-200" %>">
          <%= @rule_based_critical ? "Action required" : "Nominal" %>
        </span>
      </div>
      <ul class="mt-4 space-y-2">
        <% @rule_based_recommendations.each do |recommendation| %>
          <li class="rounded-lg border border-gray-700 bg-gray-900 p-2.5 text-xs leading-relaxed text-gray-200">
            <%= recommendation %>
          </li>
        <% end %>
      </ul>
    </section>

    <section class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_390px]">
      <div class="flex flex-col gap-5">
