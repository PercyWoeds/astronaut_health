<%# Chequeo diario de los riesgos fisiológicos NASA HRP / CSA.
    Usa DailyCheck para no mezclar estos campos con las series de HealthReading. %>
<div data-controller="modal" class="contents">
  <button type="button" data-action="click->modal#open" class="<%= quick_action_button_classes %>">
    ✅ Daily Check
  </button>

  <div data-modal-target="modal" data-action="click->modal#closeOnBackdrop"
       class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 p-4 backdrop-blur-sm">
    <div class="max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-2xl border border-slate-700 bg-slate-900 p-6 shadow-2xl">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-cyan-400">NASA HRP · CSA</p>
          <h2 class="mt-1 text-xl font-semibold text-white">Daily risk check</h2>
          <p class="mt-1 text-sm text-slate-400">Updates the zone status and the mission risk panel.</p>
        </div>
        <button type="button" data-action="click->modal#close"
                class="rounded-lg border border-slate-700 px-2.5 py-1 text-sm text-slate-400 hover:bg-slate-800">✕</button>
      </div>

      <%= form_with url: daily_checks_path(mission_id: @astronaut.mission_id, astronaut_id: @astronaut.id),
                    scope: :daily_check, method: :post, class: "mt-5 space-y-5" do |form| %>

        <div class="grid gap-4 sm:grid-cols-2">
          <div data-controller="slider" class="rounded-xl border border-slate-800 bg-slate-950/60 p-3">
            <div class="flex items-center justify-between gap-3">
              <label for="daily_check_stress_level" class="text-sm font-medium text-slate-300">Stress (isolation)</label>
              <span data-slider-target="output" class="rounded-full border border-slate-700 bg-slate-900 px-2 py-0.5 text-xs font-semibold text-cyan-200">
                <%= @daily_check.stress_level.to_i %>/10
              </span>
            </div>
            <%= form.range_field :stress_level, min: 1, max: 10, step: 1, value: @daily_check.stress_level.to_i,
                  data: { slider_target: "input", action: "input->slider#update", suffix: "/10" },
                  class: "mt-3 w-full accent-cyan-500" %>
          </div>

          <div data-controller="slider" class="rounded-xl border border-slate-800 bg-slate-950/60 p-3">
            <div class="flex items-center justify-between gap-3">
              <label for="daily_check_bone_density_loss_percent" class="text-sm font-medium text-slate-300">Bone loss
                <span class="ml-1 rounded-full border border-violet-500/40 bg-violet-500/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-violet-200">Lab result</span>
              </label>
              <span data-slider-target="output" class="rounded-full border border-slate-700 bg-slate-900 px-2 py-0.5 text-xs font-semibold text-cyan-200">
                <%= number_with_precision(@daily_check.bone_density_loss_percent, precision: 1) %>%
              </span>
            </div>
            <%= form.range_field :bone_density_loss_percent, min: 0, max: 5, step: 0.1, value: @daily_check.bone_density_loss_percent,
                  data: { slider_target: "input", action: "input->slider#update", suffix: "%" },
                  class: "mt-3 w-full accent-cyan-500" %>
            <p class="mt-2 text-[11px] text-gray-400">Entered from a medical exam (e.g., DEXA). The app does not measure bone density.</p>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= form.label :co2_level, "Ambient CO₂ (ppm)", class: "mb-1 block text-sm font-medium text-slate-300" %>
            <%= form.number_field :co2_level, min: 0, step: 1, value: @daily_check.co2_level,
                  class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-slate-100 outline-none focus:border-cyan-500" %>
            <p class="mt-1 text-[11px] text-gray-400">Reference: ISS operating limit 3.0 mmHg (~3,913 ppm) · SMAC 180-day 5.3 mmHg (~6,913 ppm) · NASA-STD-3001 — ISS reference points; not for terrestrial use.</p>
          </div>

          <div>
            <%= form.label :calories_intake, "Caloric intake (kcal)", class: "mb-1 block text-sm font-medium text-slate-300" %>
            <%= form.number_field :calories_intake, min: 0, step: 10, value: @daily_check.calories_intake,
                  class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-slate-100 outline-none focus:border-cyan-500" %>
            <p class="mt-1 text-[11px] text-gray-400">Indicative operating range: 1,800 – 3,500 kcal</p>
          </div>
        </div>

        <div class="grid gap-3 sm:grid-cols-3">
          <% [
            { field: :vision_blurred, label: "Blurred vision", hint: "SANS alert", value: @daily_check.vision_blurred },
            { field: :dizziness_reported, label: "Dizziness", hint: "Sensorimotor", value: @daily_check.dizziness_reported },
            { field: :skin_rash, label: "Skin lesion", hint: "Host-microorganism", value: @daily_check.skin_rash }
          ].each do |toggle| %>
            <label class="flex cursor-pointer items-center justify-between gap-3 rounded-xl border border-slate-800 bg-slate-950/60 p-3">
              <span>
                <span class="block text-sm font-medium text-slate-200"><%= toggle[:label] %></span>
                <span class="block text-[11px] text-slate-500"><%= toggle[:hint] %></span>
              </span>
              <span class="relative inline-flex shrink-0 items-center">
                <%= form.check_box toggle[:field], checked: toggle[:value], class: "peer sr-only" %>
                <span class="h-6 w-11 rounded-full bg-slate-700 transition peer-checked:bg-cyan-500"></span>
                <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white transition peer-checked:translate-x-5"></span>
              </span>
            </label>
          <% end %>
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button type="button" data-action="click->modal#close"
                  class="rounded-xl border border-slate-700 px-4 py-2 text-sm text-slate-300 hover:bg-slate-800">Cancel</button>
          <button type="submit"
                  class="rounded-xl bg-cyan-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-cyan-400">
            Save daily check
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>