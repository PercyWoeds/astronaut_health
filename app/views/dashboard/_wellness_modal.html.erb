<%# Nutrición y contacto social: métricas diarias de Space Physiology / ARCHeR. %>
<% meals = @latest_readings&.dig("meals_completed_percent")&.value&.to_i || 0 %>
<% social = @latest_readings&.dig("social_contact_minutes")&.value&.to_i || 0 %>

<div data-controller="modal" class="contents">
  <button type="button" data-action="click->modal#open" class="<%= quick_action_button_classes %>">
    🍽️ Comidas y Contacto
  </button>

  <div data-modal-target="modal" data-action="click->modal#closeOnBackdrop"
       class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 p-4 backdrop-blur-sm">
    <div class="w-full max-w-lg rounded-2xl border border-slate-700 bg-slate-900 p-6 shadow-2xl">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-cyan-400">Space Physiology · ARCHeR</p>
          <h2 class="mt-1 text-xl font-semibold text-white">Comidas y contacto social</h2>
          <p class="mt-1 text-sm text-slate-400">Registra la adherencia nutricional y la interacción con la tripulación.</p>
        </div>
        <button type="button" data-action="click->modal#close"
                class="rounded-lg border border-slate-700 px-2.5 py-1 text-sm text-slate-400 hover:bg-slate-800">✕</button>
      </div>

      <%= form_with url: wellness_checks_path(mission_id: @astronaut.mission_id, astronaut_id: @astronaut.id),
                    scope: :wellness_check, method: :post, class: "mt-5 space-y-4" do |form| %>

        <div data-controller="slider" class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
          <div class="flex items-center justify-between gap-3">
            <label for="wellness_check_meals_completed_percent" class="text-sm font-medium text-slate-300">🍽️ % Comidas completadas</label>
            <span data-slider-target="output" class="rounded-full border border-slate-700 bg-slate-900 px-2 py-0.5 text-xs font-semibold text-cyan-200">
              <%= meals %>%
            </span>
          </div>
          <%= form.range_field :meals_completed_percent, min: 0, max: 100, step: 1, value: meals,
                data: { slider_target: "input", action: "input->slider#update", suffix: "%" },
                class: "mt-3 w-full accent-cyan-500" %>
          <p class="mt-2 text-[11px] text-gray-400">Alerta si &lt; 50 %. Riesgo de Nutrición Inadecuada.</p>
        </div>

        <div>
          <%= form.label :social_contact_minutes, "👥 Minutos de contacto social", class: "mb-1 block text-sm font-medium text-slate-300" %>
          <%= form.number_field :social_contact_minutes, min: 0, max: 1_440, step: 1, value: social,
                class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-slate-100 outline-none focus:border-cyan-500" %>
          <p class="mt-1 text-[11px] text-gray-400">Alerta si &lt; 10 min. Riesgo de Aislamiento (ARCHeR).</p>
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button type="button" data-action="click->modal#close"
                  class="rounded-xl border border-slate-700 px-4 py-2 text-sm text-slate-300 hover:bg-slate-800">Cancelar</button>
          <button type="submit"
                  class="rounded-xl bg-cyan-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-cyan-400">
            Guardar métricas
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>