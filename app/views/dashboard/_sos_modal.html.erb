<%# Simulated priority telemedicine modal. It is not a real link or a medical device. %>
<div data-sos-target="modal"
     data-sos-delay-value="<%= @comm_delay_text.presence || 'low-latency link simulated' %>"
     class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 p-4 backdrop-blur-sm">
  <div class="w-full max-w-lg rounded-2xl border border-rose-500/40 bg-slate-900 p-6 shadow-2xl shadow-rose-500/10">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-rose-400">Simulated link · not sent</p>
        <h2 class="mt-1 text-xl font-semibold text-white">Priority telemedicine (simulation)</h2>
      </div>
      <button type="button" data-action="click->sos#close"
              class="rounded-lg border border-slate-700 px-2.5 py-1 text-sm text-slate-400 hover:bg-slate-800">✕</button>
    </div>

    <p data-sos-target="message"
       class="mt-4 rounded-xl border border-rose-500/25 bg-rose-500/5 p-4 text-sm leading-relaxed text-rose-100">
      Simulated link: transmitting telemetry. <%= @comm_delay_text.presence || "Delay with Earth: low-latency link simulated" %>.
    </p>

    <div class="mt-5">
      <div class="flex items-center justify-between text-xs text-slate-400">
        <span data-sos-target="stage">Packaging telemetry…</span>
        <span data-sos-target="percent" class="font-semibold text-rose-300">0%</span>
      </div>
      <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-800">
        <div data-sos-target="bar"
             class="h-full w-0 rounded-full bg-gradient-to-r from-rose-500 via-rose-400 to-amber-400"></div>
      </div>
    </div>

    <div class="mt-5 flex items-center justify-between gap-3">
      <p class="text-[11px] leading-relaxed text-slate-500">
        The last 10 records of the selected astronaut will be sent.
      </p>
      <button type="button" data-action="click->sos#close"
              class="shrink-0 rounded-xl border border-slate-700 px-4 py-2 text-sm text-slate-300 hover:bg-slate-800">
        Close
      </button>
    </div>
  </div>
</div>
